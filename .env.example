# Control plane
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://virgocloud:virgocloud@postgres:5432/virgocloud?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-32-character-minimum-random-secret
ENCRYPTION_KEY=replace-with-a-64-character-hex-key-for-node-secrets

# Optional Google OAuth token validation
GOOGLE_CLIENT_ID=

# S3-compatible backup storage. MinIO works with the local compose profile.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=virgocloud-backups
S3_FORCE_PATH_STYLE=true

# Web app
NEXT_PUBLIC_API_URL=http://localhost:4000

# Docker node agent — set this on each separately deployed node.
AGENT_HOST=0.0.0.0
AGENT_PORT=8080
AGENT_SHARED_SECRET=replace-with-the-secret-issued-when-enrolling-a-node
AGENT_NODE_ID=replace-with-the-node-id-issued-when-enrolling-a-node
CONTROL_PLANE_URL=https://control.example.com
AGENT_PUBLIC_HOST=runner.example.com
DOCKER_SOCKET=/var/run/docker.sock
SERVER_DATA_ROOT=/srv/virgocloud/servers
